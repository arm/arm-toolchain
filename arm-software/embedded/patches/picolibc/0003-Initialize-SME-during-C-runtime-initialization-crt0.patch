From 89e1fbf646bd8b834d6345789afa6cb48c711939 Mon Sep 17 00:00:00 2001
From: Amilendra Kodithuwakku <amilendra.kodithuwakku@arm.com>
Date: Mon, 20 Apr 2026 13:27:41 +0000
Subject: [PATCH 1/2] Initialize SME during C-runtime initialization (crt0)

Check if SME or SME2 is enabled and do the following

1. Clear TPIDR2_EL0 [1]
The value of TPIDR2_EL0 resets to an architecturally UNKNOWN value
at warm reset.
This means we need to clear it manually at startup.

2. Initialise SME Streaming SVE Vector length to 2048 bits
Initialize the SME control register SMCR_EL3 [2] to set the
effective streaming SVE vector length to the maximum supported
value of 2048 bits.

[1] https://developer.arm.com/documentation/ddi0601/2025-09/AArch64-Registers/TPIDR2-EL0--EL0-Read-Write-Software-Thread-ID-Register-2?lang=en
[2] https://developer.arm.com/documentation/ddi0601/2025-09/AArch64-Registers/SMCR-EL3--SME-Control-Register--EL3-?lang=en
---
 picocrt/crt0.h                 |  6 +++++-
 picocrt/machine/aarch64/crt0.S | 24 ++++++++++++++++++++++++
 picocrt/machine/aarch64/crt0.c | 14 ++++++++++++--
 3 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/picocrt/crt0.h b/picocrt/crt0.h
index eafdcafc1..ca4eb562c 100644
--- a/picocrt/crt0.h
+++ b/picocrt/crt0.h
@@ -96,11 +96,15 @@ int sys_semihost_get_cmdline(char *buf, int size);
 int get_cmdline(char *buffer, int size);
 #endif
 
+#ifndef BAREMETAL_START_ARGS
+#define BAREMETAL_START_ARGS void
+#endif
+
 static __noreturn __always_inline void
 #ifdef CRT0_LINUX
 __start(int argc, char **argv)
 #else
-__start(void)
+__start(BAREMETAL_START_ARGS)
 #endif
 {
 #ifndef NO_FLASH
diff --git a/picocrt/machine/aarch64/crt0.S b/picocrt/machine/aarch64/crt0.S
index e2abc2b61..263d1479d 100644
--- a/picocrt/machine/aarch64/crt0.S
+++ b/picocrt/machine/aarch64/crt0.S
@@ -41,6 +41,9 @@
 
 #define MMU_INVALID_FLAGS       0
 
+#define FEAT_SME_1      (1LL << 24)
+#define FEAT_SME_2      (1LL << 25)
+
   .macro start_page_table
   .section .rodata
   .global __identity_page_table
@@ -146,6 +149,27 @@ _start:
 #endif // __ARM_FP
 #endif
 
+	/* Determine if SME or SME2 is available */
+	mrs     x0, id_aa64pfr1_el1
+	tst     x0, (FEAT_SME_1|FEAT_SME_2)
+	cset    x0, ne /* _Bool has_sme (argument to _cstart) */
+
+	b.eq    .Lnosme
+
+	/* Clear TPIDR2_EL0 */
+	msr     S3_3_C13_C0_5, xzr
+	isb
+
+	/* set up Streaming SVE Vector Length (SVL) in SMCR_EL3 (4 LSB). */
+	mov     x2, #0xF
+
+	/* Try to set the maximum value supported by the architecture (2048). */
+	mrs     x1, s3_6_c1_c2_6 /* mrs  x1, smcr_el3 */
+	bfi     x1, x2, 0, 4
+	msr     s3_6_c1_c2_6, x1 /* msr  smcr_el3, x1 */
+	isb
+
+.Lnosme:
 	/* Jump into C code */
 	bl _cstart
   .size _start, .-_start
diff --git a/picocrt/machine/aarch64/crt0.c b/picocrt/machine/aarch64/crt0.c
index a43092ee9..dfdaf6b99 100644
--- a/picocrt/machine/aarch64/crt0.c
+++ b/picocrt/machine/aarch64/crt0.c
@@ -61,6 +61,16 @@ _set_tls(void *tls)
     __asm__ volatile("msr tpidr_el0, %x0" : : "r"(tls - TP_OFFSET));
 }
 
+#ifndef CRT0_LINUX
+_Bool __arm64_has_sme;
+static void __arm64_post_memory_setup(_Bool has_sme) {
+    /* Initialize __arm64_has_sme once .bss and .data have been setup. */
+    __arm64_has_sme = has_sme;
+}
+#define BAREMETAL_START_ARGS _Bool has_sme
+#define POST_MEMORY_SETUP() __arm64_post_memory_setup(has_sme)
+#endif
+
 #include "../../crt0.h"
 
 /* Defined in crt0.S */
@@ -119,7 +129,7 @@ void
 #ifdef CRT0_LINUX
 _cstart(void *orig_sp)
 #else
-_cstart(void)
+_cstart(_Bool has_sme)
 #endif
 {
 #ifdef CRT0_LINUX
@@ -200,7 +210,7 @@ _cstart(void)
 
     /* Set the vector base address register */
     __asm__ volatile("msr    vbar_" BOOT_EL ", %x0" ::"r"(__vector_table));
-    __start();
+    __start(has_sme);
 #endif
 }
 
