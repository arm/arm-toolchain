From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Murray <mark.murray@arm.com>
Date: Tue, 3 Nov 2026 00:00:00 +0000
Subject: [PATCH] Exclude AArch64 FPCR test without FP support

The AArch64 test-fenv source accesses FPCR directly. Clang rejects those
system-register accesses when the target architecture has floating-point
support disabled, which prevents all picolibc tests from being built.

Temporarily omit test-fenv for those configurations. This can be removed
once picolibc guards the FPCR-specific part of the test upstream.
---
 test/test-math/meson.build | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/test/test-math/meson.build b/test/test-math/meson.build
index 0ead80865..eaddf6a4b 100644
--- a/test/test-math/meson.build
+++ b/test/test-math/meson.build
@@ -219,7 +219,11 @@ foreach params : targets
   _c_args = target_c_args + get_variable('test_c_args' + target, test_c_args)
   _link_args = target_c_args + _lib_files + get_variable('test_link_args' + target, test_link_args)
   _link_depends = get_variable('test_link_depends' + target, test_link_depends) + _libs
+  exclude_aarch64_fenv = host_cpu_family == 'aarch64' and cc.get_define('__ARM_FP', args: _c_args) == ''
   foreach t1 : tests
+    if t1 == 'test-fenv' and exclude_aarch64_fenv
+      continue
+    endif
     t1_src = t1 + '.c'
     test_file_name_arg=['-DTEST_FILE_NAME="' + t1 + target + '.txt"']

     test(t1 + target,
--
2.34.1
