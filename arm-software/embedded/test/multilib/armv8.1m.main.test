## These combinations are not supported at all, because we don't provide any
## MVE libraries with the soft-float ABI, and we can't fall back to non-MVE
## soft-float libraries because they won't initialize the FPSCR correctly
## for MVE, or save and restore the vector registers in setjmp/longjmp.
## So we expect this to fail, with a custom error message.
# RUN: not %clang -print-multi-directory --target=armv8.1m.main-none-eabi -march=armv8.1m.main+mve -mfpu=none 2>%t | FileCheck --check-prefix=SOFTFP-MVE --allow-empty %s
# RUN: FileCheck --check-prefix=SOFTFP-MVE-ERR %s < %t
# RUN: not %clang -print-multi-directory --target=armv8.1m.main-none-eabi -march=armv8.1m.main+mve -mfpu=none -mno-unaligned-access 2>%t | FileCheck --check-prefix=SOFTFP-MVE --allow-empty %s
# RUN: FileCheck --check-prefix=SOFTFP-MVE-ERR %s < %t
# RUN: not %clang -print-multi-directory --target=armv8.1m.main-none-eabi -march=armv8.1m.main+mve -mfpu=none -mbranch-protection=pac-ret+bti 2>%t | FileCheck --check-prefix=SOFTFP-MVE --allow-empty %s
# RUN: FileCheck --check-prefix=SOFTFP-MVE-ERR %s < %t
# RUN: not %clang -print-multi-directory --target=armv8.1m.main-none-eabi -march=armv8.1m.main+mve -mfpu=none -mbranch-protection=pac-ret+bti -mno-unaligned-access 2>%t | FileCheck --check-prefix=SOFTFP-MVE --allow-empty %s
