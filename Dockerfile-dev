# Base image compatible with RHEL 8
FROM rockylinux/rockylinux:8 AS base

# Update /etc/yum.repos.d/Rocky-AppStream.repo to not use the RockyLinux mirror
# list, which as of October 2025 can cause `dnf` commands to fail. See this for
# details:
#   https://forums.rockylinux.org/t/mirror-list-mirrors-rockylinux-org-is-serving-out-of-sync-repositories-for-both-rl9-and-rl8/19756/8
RUN sed -i 's/mirrorlist/#mirrorlist/' /etc/yum.repos.d/Rocky-AppStream.repo
RUN sed -i 's/#baseurl/baseurl/' /etc/yum.repos.d/Rocky-AppStream.repo

# Install useful/required Rocky Linux packages
RUN dnf install -y epel-release && \
    dnf upgrade -y && \
    crb enable && \
    dnf install -y \
        bzip2 \
        cmake \
        diffutils \
        elfutils \
        file \
        findutils \
        fuse-sshfs \
        gcc-c++ \
        gdb \
        git \
        glibc-headers \
        graphviz \
        htop \
        iproute \
        jq \
        kernel-headers \
        libasan \
        libubsan \
        man \
        man-pages \
        nano \
        ncurses-compat-libs \
        netcat \
        ninja-build \
        nss_wrapper-libs \
        patch \
        plantuml \
        procps-ng \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        qemu-kvm \
        ripgrep \
        socat \
        strace \
        which \
        xz \
        zip \
        zlib-devel \
    && \
    dnf clean all && \
    alternatives --set python3 /usr/bin/python3.12 && \
    rm -rf /var/cache/dnf

# FIXME this is a temporary upgrade and pin to address certificate security incidents
# This should be replaced with a normal `pip --upgrade pip>=26.2.2` after the OS level ca-certs
# have been updated. See https://discuss.python.org/t/information-for-python-users-regarding-emudhra-emsign-ca-certificate-security-incident/109576
# for additional information.
RUN python3 -m pip install "pip @ \
    https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
RUN python3 -m pip install --no-cache-dir --upgrade \
        certifi>=2026.10.19

# Note: the Rocky Linux meson is too out-of-date to build picolibc, install the
# latest using pip instead
RUN pip3 install --no-cache-dir --upgrade meson

# Squash the image so far. This saves the spaced used by files that were
# deleted or overridden during the upgrade.
FROM scratch
COPY --from=base / /
CMD ["/bin/bash"]

# Install Google's addlicense tool to help with copyright headers
RUN curl -L --fail \
        https://github.com/google/addlicense/releases/download/v1.1.1/addlicense_1.1.1_Linux_x86_64.tar.gz | \
    tar -C /usr/local/bin/ -zx \
        addlicense

# Download and unpack regular Arm toolchain to get binutils and other useful programs.
# But remove GCC, because we don't want to accidentally use it instead of Clang.
RUN curl -L --fail \
        https://developer.arm.com/-/media/Files/downloads/gnu/13.3.rel1/binrel/arm-gnu-toolchain-13.3.rel1-x86_64-arm-none-eabi.tar.xz | \
    tar -C /usr/local -Jx --strip-components=1 \
        arm-gnu-toolchain-13.3.rel1-x86_64-arm-none-eabi/bin \
        arm-gnu-toolchain-13.3.rel1-x86_64-arm-none-eabi/share && \
    rm /usr/local/bin/arm-none-eabi-gcc* /usr/local/bin/arm-none-eabi-c++ /usr/local/bin/arm-none-eabi-g++

# Set default editor
ENV EDITOR=nano

# Set working directory
WORKDIR /workspaces
